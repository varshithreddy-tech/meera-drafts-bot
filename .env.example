TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Optional: defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional: minimum note score (0-10) needed before a draft is written. Defaults to 5.
NOTE_MIN_SCORE=5
# Any long random string (letters, numbers, _ and - only). Must match on Vercel and when running set-webhook.
TELEGRAM_WEBHOOK_SECRET=
# Meera's chat ID (send /start to the bot to see it). Comma-separate multiple IDs.
ALLOWED_CHAT_IDS=
